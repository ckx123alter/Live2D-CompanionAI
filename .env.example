# Local mode keeps existing server-side .env credentials.
APP_ENV=local
CREDENTIAL_MODE=server

# Copy to .env at the project root. Never use a VITE_ prefix for secrets.
# Fixed replies do not call the LLM; other messages require LLM_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_JSON_MODE=true
# auto disables thinking for supported DeepSeek models; omits it for other APIs.
LLM_THINKING=auto

# Doubao TTS 2.0, stock voice: 甜美娇俏 2.0.
# Use the API Key from the Doubao Voice console (not the LLM key or IAM AK/SK).
# With doubao selected, a missing key disables speech rather than changing voice.
TTS_PROVIDER=doubao
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_VOICE=ICL_uranus_zh_female_tianmeijiaoqiao_tob
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEECH_RATE=0

# Optional alternative: set TTS_PROVIDER=openai to use POST /audio/speech.
# Only this provider uses TTS_API_KEY/BASE_URL/MODEL/VOICE below.
# When openai is selected, an empty TTS_API_KEY uses device speech.
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna

# Optional shared demo password; enter it on the webpage, never an API key.
APP_PASSWORD=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5175,http://localhost:5175
REQUEST_TIMEOUT=60
REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=4
# DATABASE_PATH=data/chat.sqlite3

# Optional server-key budgets, disabled for normal local use. BYOK always ignores them.
SERVER_DAILY_BUDGETS_ENABLED=false
# Calls include LLM requests and cache-miss TTS requests.
# Token values are conservative reservations, not provider billing statistics.
DAILY_SESSION_CALLS=80
DAILY_IP_CALLS=150
DAILY_GLOBAL_CALLS=2000
DAILY_SESSION_TOKENS=500000
DAILY_IP_TOKENS=1000000
DAILY_GLOBAL_TOKENS=10000000
DAILY_SESSION_TTS_CHARS=15000
DAILY_IP_TTS_CHARS=30000
DAILY_GLOBAL_TTS_CHARS=250000
MAX_SESSION_MESSAGES=200
MAX_SESSIONS=2000
SESSION_RETENTION_DAYS=7
AUDIO_RETENTION_DAYS=7
MAX_SESSION_AUDIO_MB=20
MAX_AUDIO_CACHE_MB=256
MAX_SHARED_AUDIO_MB=32
MIN_FREE_DISK_MB=256
MAINTENANCE_INTERVAL=300
